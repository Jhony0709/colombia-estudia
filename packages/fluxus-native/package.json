{
  "name": "@fluxus-ui/native",
  "version": "0.2.0",
  "description": "Fluxus for React Native: the same tokens and motion vocabulary, on Reanimated.",
  "license": "MIT",
  "author": "Jhony0709 (https://github.com/Jhony0709)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jhony0709/fluxus.git",
    "directory": "packages/native"
  },
  "publishConfig": {
    "access": "public",
    "main": "./lib/module/index.js",
    "types": "./lib/typescript/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "./icon": {
        "types": "./lib/typescript/icon.d.ts",
        "default": "./lib/module/icon.js"
      },
      "./screen": {
        "types": "./lib/typescript/screen.d.ts",
        "default": "./lib/module/screen.js"
      },
      "./blur": {
        "types": "./lib/typescript/blur.d.ts",
        "default": "./lib/module/blur.js"
      },
      "./audio": {
        "types": "./lib/typescript/audio.d.ts",
        "default": "./lib/module/audio.js"
      },
      "./package.json": "./package.json"
    }
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./icon": "./src/icon.tsx",
    "./screen": "./src/screen.tsx",
    "./blur": "./src/blur.tsx",
    "./audio": "./src/audio.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "peerDependencies": {
    "expo-blur": ">=58",
    "react": ">=19",
    "react-native": ">=0.86",
    "react-native-reanimated": ">=4.5",
    "react-native-safe-area-context": ">=5",
    "react-native-svg": ">=15",
    "react-native-worklets": ">=0.10",
    "expo-audio": ">=58"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-audio": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
