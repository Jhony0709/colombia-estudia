# Colombia Estudia — variables de entorno (reference/08-env-vars.md es la fuente)
# Copia este archivo a `.env` (ignorado por git) y rellena con los valores de STAGING:
# el desarrollo local corre contra el proyecto Supabase `colombia-estudia-staging` (sin Supabase CLI).
# Nunca valores de producción aquí; nunca `.env` en un commit.

# ── Base de datos (Supabase → Connect → usuario `prisma.<project-ref>`) ──────────────────
# DATABASE_URL: transaction pooler (puerto 6543), para el runtime serverless.
# DIRECT_URL:   session pooler (puerto 5432), solo para `prisma migrate deploy`.
DATABASE_URL="postgres://prisma.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgres://prisma.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Supabase (Project Settings → API Keys; llaves nuevas, no las legacy anon/service_role) ──
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Solo servidor. Salta RLS. Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# ── App ──────────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TZ="America/Bogota"

# ── Email (Resend) — vacío en local hasta que exista la cuenta ───────────────────────────
RESEND_API_KEY=""
EMAIL_DOMAIN="colombiaestudia.co"

# ── Video (Vimeo) — vacío en local ───────────────────────────────────────────────────────
VIMEO_ACCESS_TOKEN=""

# ── Job diario (POST /api/jobs/daily) — `openssl rand -hex 32`, distinto por entorno ─────
CRON_SECRET=""

# ── Pagos (Wompi) — llaves de sandbox en staging; vacío en local ─────────────────────────
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_EVENTS_SECRET=""
WOMPI_INTEGRITY_SECRET=""
# Opcionales: por defecto sandbox (`https://sandbox.wompi.co/v1`) y `https://checkout.wompi.co/p/`
WOMPI_API_URL=""
WOMPI_CHECKOUT_URL=""

# ── Observabilidad (Sentry) — vacío en local ─────────────────────────────────────────────
SENTRY_DSN=""

# ── Tests de integración ─────────────────────────────────────────────────────────────────
# NO van en este archivo. Corren contra un Postgres plano local y las variables se pasan en
# la línea de comando (ver docs/estado.md § Solo Jhonny):
#   docker run --name ce-test-pg -e POSTGRES_PASSWORD=postgres -p 5433:5432 -d postgres:16
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres" \
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5433/postgres" \
#   pnpm prisma migrate deploy --schema prisma/schema.prisma
#   RUN_DB_TESTS=1 DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres" \
#   pnpm --filter @colombia-estudia/web test:integration
