    {
      "id": "s2",
      "tipo": "conceptos",
      "titulo": "Los tipos de textos",
      "texto": "Según lo que el autor quiere expresar, un texto puede ser narrativo, si cuenta hechos; descriptivo, si explica cómo es algo; expositivo, si presenta información; o argumentativo, si defiende una opinión.",
      "voz": "Según lo que el autor quiere expresar, un texto puede ser narrativo, si cuenta hechos; descriptivo, si explica cómo es algo; expositivo, si presenta información; o argumentativo, si defiende una opinión.",
      "items": [
        {
          "titulo": "Narrativo",
          "texto": "Cuenta hechos reales o imaginarios",
          "palabra": "narrativo"
        },
        {
          "titulo": "Descriptivo",
          "texto": "Explica cómo es algo",
          "palabra": "descriptivo"
        },
        {
          "titulo": "Expositivo",
          "texto": "Presenta información sobre un tema",
          "palabra": "expositivo"
        },
        {
          "titulo": "Argumentativo",
          "texto": "Defiende una opinión con razones",
          "palabra": "argumentativo"
        }
      ],
