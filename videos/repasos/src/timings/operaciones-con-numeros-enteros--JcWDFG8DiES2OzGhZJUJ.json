    {
      "id": "s2",
      "tipo": "conceptos",
      "titulo": "Las reglas de los signos",
      "texto": "Para sumar con signos iguales, se suman y se conserva el signo; con signos diferentes, se restan y queda el signo del número con mayor valor absoluto. Para restar, se suma el opuesto: 5 − 8 = 5 + (−8) = −3. Y al multiplicar o dividir, signos iguales dan positivo y signos diferentes, negativo.",
      "voz": "Para sumar con signos iguales, se suman y se conserva el signo; con signos diferentes, se restan y queda el signo del número con mayor valor absoluto. Para restar, se suma el opuesto: cinco menos ocho es igual a cinco más menos ocho, que da menos tres. Y al multiplicar o dividir, signos iguales dan positivo y signos diferentes, negativo.",
      "items": [
        {
          "titulo": "Sumar",
          "texto": "Iguales: se suman y se conserva el signo. Diferentes: se restan y queda el del mayor valor absoluto",
          "palabra": "sumar"
        },
        {
          "titulo": "Restar",
          "texto": "Se suma el opuesto: 5 − 8 = 5 + (−8) = −3",
          "palabra": "restar"
        },
        {
          "titulo": "Multiplicar y dividir",
          "texto": "Signos iguales: positivo. Diferentes: negativo",
          "palabra": "multiplicar"
        }
      ],
      "audio": "voz/operaciones-con-numeros-enteros/JcWDFG8DiES2OzGhZJUJ/s2.mp3",
      "lead": 10,
      "voiceFrames": 581,
