        {
          "text": "El realismo mágico presenta hechos extraordinarios",
          "from": 0,
          "to": 73
        },
        {
          "text": "en ambientes cotidianos, y los personajes",
          "from": 73,
          "to": 134
        },
        {
          "text": "los aceptan como normales:",
          "from": 134,
          "to": 172
        },
        {
          "text": "personas que levitan o lluvias que duran años.",
          "from": 181,
          "to": 254
        },
        {
          "text": "Su gran referente es Cien años",
          "from": 264,
          "to": 326
        },
        {
          "text": "de soledad, de Gabriel García Márquez,",
          "from": 326,
          "to": 404
        },
        {
          "text": "Premio Nobel de Literatura en 1982.",
          "from": 404,
          "to": 476
        }
