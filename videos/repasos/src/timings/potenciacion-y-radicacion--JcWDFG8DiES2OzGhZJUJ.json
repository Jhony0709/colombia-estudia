    {
      "id": "s3",
      "tipo": "conceptos",
      "titulo": "Propiedades de la potenciación",
      "texto": "Con potencias de igual base, en el producto se suman los exponentes y en el cociente se restan. En la potencia de una potencia, se multiplican.",
      "voz": "Con potencias de igual base, en el producto se suman los exponentes y en el cociente se restan. En la potencia de una potencia, se multiplican.",
      "items": [
        {
          "titulo": "Producto",
          "texto": "2³ × 2² = 2⁵: se suman",
          "palabra": "producto"
        },
        {
          "titulo": "Cociente",
          "texto": "3⁴ ÷ 3² = 3²: se restan",
          "palabra": "cociente"
        },
        {
          "titulo": "Potencia de una potencia",
          "texto": "(2³)² = 2⁶: se multiplican",
          "palabra": "potencia"
        }
