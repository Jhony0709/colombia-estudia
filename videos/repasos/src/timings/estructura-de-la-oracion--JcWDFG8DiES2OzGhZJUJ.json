    {
      "id": "s2",
      "tipo": "conceptos",
      "titulo": "Los complementos del verbo",
      "texto": "Los complementos agregan información al verbo. El directo dice qué recibe la acción; el indirecto, a quién o para quién se destina; y el circunstancial, dónde, cuándo, cómo o por qué ocurre.",
      "voz": "Los complementos agregan información al verbo. El directo dice qué recibe la acción; el indirecto, a quién o para quién se destina; y el circunstancial, dónde, cuándo, cómo o por qué ocurre.",
      "items": [
        {
          "titulo": "Directo",
          "texto": "¿Qué recibe la acción? Ana compró un cuaderno",
          "palabra": "directo"
        },
        {
          "titulo": "Indirecto",
          "texto": "¿Para quién? Ana entregó un regalo a su amiga",
          "palabra": "indirecto"
        },
        {
          "titulo": "Circunstancial",
          "texto": "¿Dónde, cuándo, cómo? Ana estudia en su habitación",
          "palabra": "circunstancial"
        }
      ],
