          "titulo": "Mendel",
          "texto": "Siglo XIX: cruces de plantas",
          "palabra": "mendel"
        },
        {
          "titulo": "Cuadro de Punnett",
          "texto": "Aa × Aa",
          "palabra": "punnett"
        },
        {
          "titulo": "3 de cada 4",
          "texto": "Moradas; 1 de cada 4, blancas",
          "palabra": "blancas"
        }
      ],
