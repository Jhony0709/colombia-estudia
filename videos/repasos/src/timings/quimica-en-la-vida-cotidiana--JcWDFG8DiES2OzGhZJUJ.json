    {
      "id": "s3",
      "tipo": "conceptos",
      "titulo": "Las soluciones",
      "texto": "Una solución tiene un soluto, que se disuelve, y un solvente, que lo disuelve, como la sal en el agua. Se disuelve más rápido al agitar, con partículas pequeñas y, en muchos sólidos, con calor. Y puede ser diluida, concentrada o saturada.",
      "voz": "Una solución tiene un soluto, que se disuelve, y un solvente, que lo disuelve, como la sal en el agua. Se disuelve más rápido al agitar, con partículas pequeñas y, en muchos sólidos, con calor. Y puede ser diluida, concentrada o saturada.",
      "items": [
        {
          "titulo": "Soluto",
          "texto": "Lo que se disuelve: la sal",
          "palabra": "soluto"
        },
        {
          "titulo": "Solvente",
          "texto": "Lo que disuelve: el agua",
          "palabra": "solvente"
        },
        {
          "titulo": "Más rápido",
          "texto": "Agitar, partículas pequeñas, calor",
          "palabra": "agitar"
        },
        {
          "titulo": "Concentración",
          "texto": "Diluida, concentrada, saturada",
          "palabra": "diluida"
        }
