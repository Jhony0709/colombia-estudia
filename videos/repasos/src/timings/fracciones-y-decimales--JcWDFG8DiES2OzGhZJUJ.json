    {
      "id": "s3",
      "tipo": "conceptos",
      "titulo": "Operar con fracciones",
      "texto": "Con el mismo denominador, sumamos o restamos los numeradores. Para multiplicar, multiplicamos los numeradores entre sí y los denominadores entre sí. Para dividir, multiplicamos por el inverso de la segunda fracción.",
      "voz": "Con el mismo denominador, sumamos o restamos los numeradores. Para multiplicar, multiplicamos los numeradores entre sí y los denominadores entre sí. Para dividir, multiplicamos por el inverso de la segunda fracción.",
      "items": [
        {
          "titulo": "Sumar y restar",
          "texto": "Mismo denominador: se operan los numeradores",
          "palabra": "sumamos"
        },
        {
          "titulo": "Multiplicar",
          "texto": "Numerador por numerador, denominador por denominador",
          "palabra": "multiplicar"
        },
        {
          "titulo": "Dividir",
          "texto": "Por el inverso de la segunda",
          "palabra": "dividir"
        }
      ],
      "audio": "voz/fracciones-y-decimales/JcWDFG8DiES2OzGhZJUJ/s3.mp3",
      "lead": 10,
      "voiceFrames": 363,
      "frames": 391,
      "chunks": [
        {
          "text": "Con el mismo denominador, sumamos",
