    {
      "id": "s2",
      "tipo": "conceptos",
      "titulo": "Tipos de fracciones",
      "texto": "Una fracción es propia si el numerador es menor, como 2/5; impropia si es mayor, como 7/4; aparente si representa un entero, como 8/4; y equivalente si vale lo mismo que otra, como 1/2 y 2/4.",
      "voz": "Una fracción es propia si el numerador es menor, como dos quintos; impropia si es mayor, como siete cuartos; aparente si representa un entero, como ocho cuartos; y equivalente si vale lo mismo que otra, como un medio y dos cuartos.",
      "items": [
        {
          "titulo": "Propia",
          "texto": "2/5",
          "palabra": "propia"
        },
        {
          "titulo": "Impropia",
          "texto": "7/4",
          "palabra": "impropia"
        },
        {
          "titulo": "Aparente",
          "texto": "8/4 = 2",
          "palabra": "aparente"
        },
        {
          "titulo": "Equivalente",
          "texto": "1/2 = 2/4",
          "palabra": "equivalente"
        }
      ],
      "audio": "voz/fracciones-y-decimales/JcWDFG8DiES2OzGhZJUJ/s2.mp3",
      "lead": 10,
      "voiceFrames": 371,
      "frames": 399,
      "chunks": [
        {
          "text": "Una fracción es propia si el",
