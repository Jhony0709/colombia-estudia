    {
      "id": "s3",
      "tipo": "comparar",
      "titulo": "Los movimientos de la Tierra",
      "texto": "La Tierra tiene dos movimientos. La rotación es el giro sobre su eje: dura 24 horas y produce el día y la noche. La traslación es el giro alrededor del Sol: dura 365 días y 6 horas, y por eso cada 4 años hay un año bisiesto.",
      "voz": "La Tierra tiene dos movimientos. La rotación es el giro sobre su eje: dura veinticuatro horas y produce el día y la noche. La traslación es el giro alrededor del Sol: dura trescientos sesenta y cinco días y seis horas, y por eso cada cuatro años hay un año bisiesto.",
      "columnas": [
        {
          "titulo": "Rotación",
          "palabra": "rotación",
          "puntos": [
            {
              "texto": "Gira sobre su eje",
              "palabra": "eje"
            },
            {
              "texto": "Dura 24 horas",
              "palabra": "veinticuatro"
            },
            {
              "texto": "Produce el día y la noche",
              "palabra": "noche"
            }
          ]
        },
        {
          "titulo": "Traslación",
          "palabra": "traslación",
          "puntos": [
            {
              "texto": "Gira alrededor del Sol",
              "palabra": "alrededor"
            },
            {
              "texto": "Dura 365 días y 6 horas",
              "palabra": "trescientos"
            },
            {
              "texto": "Cada 4 años, un año bisiesto",
              "palabra": "bisiesto"
            }
          ]
        }
      ],
