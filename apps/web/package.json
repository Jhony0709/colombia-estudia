{
  "name": "@colombia-estudia/web",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  },
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "prisma generate --schema=../../prisma/schema.prisma && next build",
    "start": "next start -p 3030",
    "lint": "next lint --dir app --dir components --dir lib --dir features",
    "lint:arch": "depcruise app features components lib --config .dependency-cruiser.js",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "jest",
    "test:unit": "jest --testPathPattern='(__tests__/unit|components/|features/)'",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:e2e": "playwright test",
    "a11y": "pa11y-ci",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "test-storybook": "test-storybook"
  },
  "dependencies": {
    "@colombia-estudia/design-tokens": "workspace:*",
    "@colombia-estudia/domain": "workspace:*",
    "@colombia-estudia/types": "workspace:*",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "@sentry/nextjs": "^8.0.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.43.0",
    "@tanstack/react-query": "^5.0.0",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.46.0",
    "next": "^15.0.0",
    "next-intl": "^4.0.0",
    "pino": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remark-directive": "^3.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.3.0",
    "unified": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.47.0",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/addon-docs": "9.1.20",
    "@storybook/addon-links": "9.1.20",
    "@storybook/addon-themes": "9.1.20",
    "@storybook/nextjs-vite": "9.1.20",
    "@storybook/test-runner": "^0.23.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "axe-playwright": "^2.0.0",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-storybook": "9.1.20",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pa11y-ci": "^3.1.0",
    "pino-pretty": "^11.0.0",
    "playwright": "^1.47.0",
    "postcss": "^8.4.0",
    "prisma": "5.22.0",
    "storybook": "9.1.20",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5",
    "wait-on": "^8.0.0"
  }
}
