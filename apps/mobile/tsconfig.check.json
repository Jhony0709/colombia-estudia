{
  // packages/fluxus-native no trae @types/react (VENDOR.md): se le dan los de la app. Aparte de
  // tsconfig.json porque Metro y jest-expo convierten `paths` en alias de ejecución.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  }
}
