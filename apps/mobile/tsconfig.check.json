{
  // En el monorepo conviven los tipos de React 18 (web) y 19: se fijan los de la app. Aparte de
  // tsconfig.json porque Metro y jest-expo convierten `paths` en alias de ejecución.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  }
}
